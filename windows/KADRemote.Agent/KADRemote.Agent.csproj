<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Kad</AssemblyName>
    <RootNamespace>KADRemote.Agent</RootNamespace>
    <ApplicationIcon>..\KADRemote.Host\Assets\kad.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.4.0</Version>
    <AssemblyVersion>1.4.0.0</AssemblyVersion>
    <FileVersion>1.4.0.0</FileVersion>
    <Product>KAD Remote Server Management</Product>
    <Company>KAD Systems</Company>
    <Copyright>Copyright (c) 2026 KAD Systems. All rights reserved.</Copyright>
    <Description>KAD Remote - Windows Server Management Agent</Description>
    <NeutralLanguage>vi-VN</NeutralLanguage>

    <!-- Slim uncompressed single-file publish with SourceGen JSON for low size & maximum Windows Defender/SmartScreen compatibility -->
    <EnableRequestDelegateGenerator>false</EnableRequestDelegateGenerator>
    <NoWarn>$(NoWarn);IL2026</NoWarn>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EventSourceSupport>false</EventSourceSupport>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <MetricsSupport>false</MetricsSupport>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\ConfigSlot.txt" LogicalName="KADRemote.ConfigSlot.txt" />
  </ItemGroup>

</Project>
