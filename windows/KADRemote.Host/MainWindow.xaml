<Window x:Class="KADRemote.Host.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KAD Remote - Quản Lý PC Từ Xa"
        Width="940" Height="640" MinWidth="840" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="#0B1120"
        Foreground="#F8FAFC"
        Icon="Assets/kad.ico"
        Closing="Window_Closing">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="12" Padding="18,14" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="42" Height="42" CornerRadius="10" Margin="0,0,14,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#0EA5E9" Offset="0"/>
                                <GradientStop Color="#2563EB" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="K" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="KAD Remote" FontSize="20" FontWeight="Bold" Foreground="#F8FAFC"/>
                        <TextBlock x:Name="SubtitleText" Text="PC Host • Sẵn sàng kết nối từ iPhone" FontSize="12.5" Foreground="#94A3B8"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#052E16" BorderBrush="#166534" BorderThickness="1" CornerRadius="16" Padding="12,6" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#22C55E" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ServerStatusText" Text="Đang chạy" FontSize="12.5" FontWeight="SemiBold" Foreground="#4ADE80"/>
                        </StackPanel>
                    </Border>
                    <Button Content="Ẩn xuống Tray" Style="{StaticResource SecondaryBtn}" Click="MinimizeTray_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="0.85*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Column: Connection & Security -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Remote Tunnel Card -->
                    <Border Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Kết nối từ xa (Khi đi ngoài đường / 4G)" FontSize="15" FontWeight="SemiBold" Foreground="#38BDF8"/>
                                    <TextBlock x:Name="TunnelStatusText" Text="Chưa bật" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button x:Name="ToggleTunnelBtn" Content="Bật Tunnel" Style="{StaticResource PrimaryBtn}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="ToggleTunnel_Click"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TunnelUrlBox" IsReadOnly="True" Text="Chưa có URL — bấm Bật Tunnel để tạo link từ xa"
                                         Background="#0B1120" Foreground="#E2E8F0" BorderBrush="#334155" BorderThickness="1"
                                         Padding="10,8" FontFamily="Consolas" FontSize="12.5" VerticalContentAlignment="Center"/>
                                <Button Grid.Column="2" Content="Copy" Style="{StaticResource SecondaryBtn}" Click="CopyTunnelUrl_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Local / Tailscale Card -->
                    <Border Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Kết nối nội bộ (Wi-Fi nhà / Tailscale)" FontSize="15" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="LocalUrlsCombo" Background="#0B1120" Foreground="#0F172A" Padding="10,7" FontFamily="Consolas" FontSize="12.5" SelectionChanged="LocalUrlsCombo_SelectionChanged"/>
                                <Button Grid.Column="2" Content="Copy" Style="{StaticResource SecondaryBtn}" Click="CopyLocalUrl_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Security & Port Card -->
                    <Border Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Bảo mật &amp; Cổng kết nối" FontSize="15" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,10"/>

                            <TextBlock Text="Access Token (bắt buộc để iPhone xác thực)" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TokenBox" IsReadOnly="True" Background="#0B1120" Foreground="#38BDF8"
                                         BorderBrush="#334155" BorderThickness="1" Padding="10,8" FontFamily="Consolas" FontSize="13"/>
                                <Button Grid.Column="2" Content="Copy" Style="{StaticResource SecondaryBtn}" Click="CopyToken_Click"/>
                                <Button Grid.Column="4" Content="Đổi Token" Style="{StaticResource SecondaryBtn}" Click="RegenToken_Click"/>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Cổng (Port):" VerticalAlignment="Center" Foreground="#CBD5E1" FontSize="13"/>
                                <TextBox Grid.Column="2" x:Name="PortBox" Background="#0B1120" Foreground="#E2E8F0"
                                         BorderBrush="#334155" BorderThickness="1" Padding="10,6" FontFamily="Consolas"/>
                                <Button Grid.Column="4" Content="Áp dụng cổng" Style="{StaticResource SecondaryBtn}" Click="ApplyPort_Click"/>
                            </Grid>

                            <StackPanel Margin="0,6,0,0">
                                <CheckBox x:Name="AutoStartCheck" Content="Tự khởi động cùng Windows" Foreground="#CBD5E1" Margin="0,0,0,6" Checked="SettingsCheck_Changed" Unchecked="SettingsCheck_Changed"/>
                                <CheckBox x:Name="AutoTunnelCheck" Content="Tự bật Tunnel từ xa khi mở app" Foreground="#CBD5E1" Margin="0,0,0,6" Checked="SettingsCheck_Changed" Unchecked="SettingsCheck_Changed"/>
                                <CheckBox x:Name="TrayOnCloseCheck" Content="Ẩn xuống System Tray khi bấm nút X" Foreground="#CBD5E1" Checked="SettingsCheck_Changed" Unchecked="SettingsCheck_Changed"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Right Column: QR Code + Activity Log -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- QR Code Card -->
                <Border Grid.Row="0" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="12" Padding="18">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Quét QR bằng app KAD Remote iOS" FontSize="15" FontWeight="SemiBold" Foreground="#F8FAFC" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock x:Name="QrTargetLabel" Text="Đang dùng: LAN" FontSize="12" Foreground="#38BDF8" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                        <Border Background="White" CornerRadius="10" Padding="10" HorizontalAlignment="Center">
                            <Image x:Name="QrImage" Width="180" Height="180" Stretch="Uniform"/>
                        </Border>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                            <RadioButton x:Name="QrPreferTunnelRadio" Content="Ưu tiên Tunnel từ xa" Foreground="#CBD5E1" IsChecked="True" Margin="0,0,12,0" Checked="QrMode_Changed"/>
                            <RadioButton x:Name="QrPreferLocalRadio" Content="Dùng LAN / IP" Foreground="#CBD5E1" Checked="QrMode_Changed"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Live Log Card -->
                <Border Grid.Row="2" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="12" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Nhật ký hoạt động (Live Log)" FontSize="14" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,8"/>
                        <ListBox Grid.Row="1" x:Name="LogList" Background="#0B1120" BorderBrush="#1F2937" Foreground="#94A3B8"
                                 FontFamily="Consolas" FontSize="11.5" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Formatted}" TextWrapping="Wrap" Margin="0,2"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
